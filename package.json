{
  "name": "second-life-commerce",
  "version": "0.1.0",
  "description": "Second Life Commerce - Zero-Touch Returns Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "dev:api": "tsx --env-file=.env --watch src/presentation/api/server.ts",
    "start": "tsx src/index.ts",
    "start:local": "tsx --env-file=.env src/index.ts",
    "start:api": "tsx --env-file=.env src/presentation/api/server.ts",
    "seed": "tsx --env-file=.env src/infrastructure/db/seedProducts.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "fast-check": "^4.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1068.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.0",
    "sharp": "^0.35.1"
  }
}
